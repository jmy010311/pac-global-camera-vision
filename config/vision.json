{
  "camera": {
    "index": "auto",
    "backend": "auto",
    "scan_max_index": 8,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "warmup_frames": 8,
    "read_fail_limit": 20,
    "name": "APC850"
  },
  "calibration": {
    "enabled": true,
    "file": "config/camera_calibration.json",
    "alpha": 0.0
  },
  "partition": {
    "min_area_ratio": 0.025,
    "max_area_ratio": 0.95,
    "min_confidence": 0.4,
    "canny_sigma": 0.33,
    "approx_epsilon_ratio": 0.025,
    "max_aspect_ratio": 4.0,
    "grid_evidence_weight": 0.25,
    "temporal_alpha": 0.15,
    "median_window": 5,
    "corner_deadband_ratio": 0.005,
    "lock_after_frames": 10,
    "unlock_ratio": 0.045,
    "unlock_frames": 5,
    "hold_frames": 6
  },
  "grid": {
    "rows": 3,
    "cols": 3,
    "auto_detect": true,
    "min_rows": 1,
    "max_rows": 12,
    "min_cols": 1,
    "max_cols": 12,
    "topology_min_confidence": 0.45,
    "switch_confirm_frames": 3,
    "rectified_width": 720,
    "rectified_height": 720,
    "inner_margin_ratio": 0.035
  },
  "occupancy": {
    "enabled": true,
    "empty_threshold": 0.34,
    "occupied_threshold": 0.55,
    "cell_inset_ratio": 0.08,
    "color_delta_threshold": 26.0,
    "temporal_alpha": 0.18,
    "_note": "single-camera appearance cue only; never used for dual-camera height"
  },
  "mesh_rectification": {
    "enabled": true,
    "search_ratio": 0.22,
    "max_displacement_ratio": 0.1,
    "regularization_strength": 0.3,
    "regularization_iterations": 1,
    "min_confidence": 0.28,
    "temporal_alpha": 0.14,
    "deadband_px": 1.5,
    "lock_after_frames": 10,
    "unlock_px": 8.0,
    "unlock_frames": 5
  },
  "dual_camera": {
    "enabled": true,
    "inspection_pose_only": true,
    "global_camera": {
      "index": 0,
      "backend": "dshow",
      "scan_max_index": 8,
      "width": 1280,
      "height": 720,
      "fps": 30,
      "pixel_format": "MJPG",
      "warmup_frames": 8,
      "name": "APC850-GLOBAL"
    },
    "wrist_camera": {
      "index": 1,
      "backend": "dshow",
      "scan_max_index": 8,
      "width": 1280,
      "height": 720,
      "fps": 30,
      "pixel_format": "MJPG",
      "warmup_frames": 8,
      "name": "AU100-WRIST"
    },
    "global_calibration": {
      "enabled": true,
      "file": "config/camera_calibration.json",
      "alpha": 0.0
    },
    "wrist_calibration": {
      "enabled": true,
      "file": "config/wrist_camera_calibration.json",
      "alpha": 0.0
    },
    "surface_calibration_file": "config/dual_surface_calibration.json",
    "min_plane_points": 8,
    "edge_points_per_segment": 3,
    "homography_ransac_threshold_px": 3.0,
    "max_reprojection_error_px": 3.0,
    "ratio_test": 0.78,
    "max_descriptor_distance": 72.0,
    "orb_features": 2200,
    "min_matches_per_cell": 4,
    "cell_inset_ratio": 0.12,
    "floor_threshold_px": 2.5,
    "raised_threshold_px": 5.0,
    "raised_fraction_threshold": 0.35,
    "direction_coherence_threshold": 0.55,
    "max_parallax_px": 80.0,
    "state_confirm_frames": 3,
    "hold_unknown_frames": 4,
    "stereo": {
      "calibration_file": "config/stereo_calibration.json",
      "feature": "sift",
      "max_features": 4000,
      "ratio_test": 0.8,
      "epipolar_tolerance_px": 1.5,
      "fundamental_ransac_px": 1.25,
      "fundamental_confidence": 0.995,
      "max_reprojection_px": 2.0,
      "min_depth_mm": 50.0,
      "max_depth_mm": 3000.0,
      "min_points_per_cell": 8,
      "floor_tolerance_mm": 4.0,
      "max_uncertainty_mm": 6.0,
      "min_inlier_ratio": 0.55,
      "ransac_tolerance_mm": 3.0,
      "cell_inset_ratio": 0.12,
      "disparity_noise_px": 0.5,
      "height_significance_sigma": 2.5,
      "temporal_window": 5,
      "min_interval_s": 0.3,
      "min_calibration_pairs": 10,
      "max_stereo_rms_px": 1.5,
      "min_baseline_mm": 20.0
    },
    "_note_aux": "floor_threshold_px/raised_threshold_px are for the auxiliary floor-homography residual view only"
  },
  "output": {
    "write_json": false,
    "json_path": "latest_scene.json",
    "json_interval_frames": 10
  },
  "outer_boundary": {
    "enabled": true,
    "analysis_size": 384,
    "margin_ratio": 0.18,
    "search_ratio": 0.15,
    "inward_ratio": 0.09,
    "tilt_ratio": 0.15,
    "min_termination": 0.35,
    "iterations": 2,
    "max_move_ratio": 0.22,
    "max_area_shrink_ratio": 0.04
  },
  "boundary": {
    "update_interval_frames": 1,
    "analysis_size": 512,
    "margin_ratio": 0.06,
    "evidence_ratio": 0.3,
    "use_lsd": true,
    "tilt_ratio": 0.05,
    "bow_ratio": 0.035,
    "min_coverage": 0.45,
    "min_line_coverage": 0.35,
    "accept_score": 0.5,
    "min_cell_ratio": 0.48,
    "min_junction_support": 0.82,
    "min_structural_coverage": 0.9,
    "shadow_excess_ratio": 1.7,
    "border_merge_ratio": 0.45,
    "min_cell_size_ratio": 0.035,
    "segment_min_coverage": 0.22,
    "temporal_alpha": 0.25,
    "association_ratio": 0.035,
    "path_alpha": 0.35,
    "confirm_frames": 3,
    "max_lines_per_axis": 11
  }
}
